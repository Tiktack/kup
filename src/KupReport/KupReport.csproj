<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>kup</AssemblyName>
    <RootNamespace>KupReport</RootNamespace>

    <!-- Native AOT -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.8.0" GeneratePathProperty="true" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*" />
  </ItemGroup>

  <!-- Embed the QuestPDF native libraries for the selected RID so Native AOT
       publishes remain single-file on every supported platform. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and Exists('$(PkgQuestPDF)\runtimes\$(RuntimeIdentifier)\native')">
    <EmbeddedResource Include="$(PkgQuestPDF)\runtimes\$(RuntimeIdentifier)\native\*"
                      LogicalName="KupReport.Native.%(Filename)%(Extension)"
                      Visible="false" />
  </ItemGroup>

  <!-- Drop QuestPDF's loose native libraries and default font from the publish
       output (embedded above). -->
  <Target Name="PruneQuestPdfPublishFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'QuestPdfSkia' or '%(Filename)' == 'qpdf' or '%(Filename)' == 'libQuestPdfSkia' or '%(Filename)' == 'libqpdf'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('LatoFont'))" />
    </ItemGroup>
  </Target>

</Project>
