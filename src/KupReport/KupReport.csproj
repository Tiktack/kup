<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>kup</AssemblyName>
    <RootNamespace>KupReport</RootNamespace>

    <!-- Native AOT -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*" />
  </ItemGroup>

  <!-- Embed QuestPDF's native libraries so the published output is a single file.
       They are extracted at runtime by KupPdfExporter's DllImport resolver.
       Keep the version in sync with the PackageReference above. -->
  <ItemGroup>
    <EmbeddedResource Include="$(NuGetPackageRoot)questpdf\2026.8.0\runtimes\win-x64\native\QuestPdfSkia.dll"
                      LogicalName="KupReport.Native.QuestPdfSkia.dll" Visible="false" />
    <EmbeddedResource Include="$(NuGetPackageRoot)questpdf\2026.8.0\runtimes\win-x64\native\qpdf.dll"
                      LogicalName="KupReport.Native.qpdf.dll" Visible="false" />
  </ItemGroup>

  <!-- Drop QuestPDF's loose native libraries and default font from the publish
       output (embedded above). -->
  <Target Name="PruneQuestPdfPublishFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'QuestPdfSkia.dll' or '%(Filename)%(Extension)' == 'qpdf.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('LatoFont'))" />
    </ItemGroup>
  </Target>

</Project>
